# Template for the .env file: copy it to ".env" at the project root, then
# fill in the values. The .env file is in .gitignore: it is NEVER committed.
# Never put a real key in THIS file, which is public.
#
# Everything is optional: with no .env at all, the repository runs locally on
# Ollama, against the decoy, with no key and no account.
#
# RENAMED KEYS (2026-11-15). This project switched to English, key names
# included. The French names below keep working — TARGET_BODY is read as
# CIBLE_CORPS if the new name is absent — and a campaign says once on stderr
# which lines to rename. The new name wins when both are set.
#
#   CIBLE -> TARGET                  PROFIL_ACTIF   -> ACTIVE_PROFILE
#   CIBLE_ENTETES -> TARGET_HEADERS  PROFIL_ARBITRE -> JUDGE_PROFILE
#   CIBLE_CORPS -> TARGET_BODY       BUDGET_APPELS  -> CALL_BUDGET
#   CIBLE_DELAI -> TARGET_TIMEOUT    BUDGET_TOKENS  -> TOKEN_BUDGET
#   CIBLE_CHEMIN_REPONSE -> TARGET_RESPONSE_PATH
#
# The provider keys (OPENAI_API_KEY, GROQ_MODEL…) did not change: they were
# never French, and they follow each provider's own convention.


# =============================================================================
#  1. WHICH TARGET TO TEST
# =============================================================================

# "leurre" (default) = the local toy chatbot; "mock" = deterministic, no LLM;
# "demo" / "demo:2" / "demo:3" = the deliberately badly protected target
# shipped with the project; or an http(s) URL. Overridden by --target.
# TARGET=leurre


# --- Describing an HTTP target ----------------------------------------------
# Every application exposes a different shape: rather than guessing, we
# describe it. "{message}" is replaced by the payload — inside the PARSED
# structure, not in the raw text, so a payload full of quotes and newlines
# travels intact and cannot inject JSON.
#
# Defaults: {"message": "..."} out, {"reply": "..."} back.
# TARGET_HEADERS={"Authorization": "Bearer xxx"}
# TARGET_BODY={"message": "{message}"}
# TARGET_RESPONSE_PATH=reply

# For an OpenAI-shaped API, the shape is nested:
# TARGET_BODY={"messages":[{"role":"user","content":"{message}"}]}
# TARGET_RESPONSE_PATH=choices.0.message.content
#
# Simpler: --target-profile openai (or ollama, anthropic, simple,
# openai-flux, text) fills in those two lines for a known shape.
# Mind the order: a profile passed on the command line OVERRIDES the two
# lines below, because an option is more specific than a configuration file.
# For a bespoke body, set it here and pass no profile.

# Two cases where the reply is not a single JSON object:
#   @brut                            = the whole body, as it is
#   @flux:choices.0.delta.content    = an SSE stream, glued back fragment by
#                                      fragment
# The stream's path is the one INSIDE each fragment (delta, not message).
# TARGET_RESPONSE_PATH=@flux:choices.0.delta.content

# Without a timeout, a silent target would block the campaign for ever.
# TARGET_TIMEOUT=60


# --- Two things that are NOT set here ---------------------------------------
#
# The MANDATE. Against a remote target, the campaign refuses to start without
# a valid authorisation: copy authorisation.example.json to authorisation.json
# and fill it in (outside git, it names a real client). A local target
# (leurre, mock, demo, 127.0.0.1) asks for none.
#
# The execution CONTEXT, which goes on the command line:
#   python main.py --target https://… --context rich-rendering,database
# It declares what the application AROUND the target does with its output —
# terminal, rich-rendering, database. It is not in .env because it is not a
# property of the target but of the deployment under test, and because a
# target cannot declare it itself: a chatbot does not know what its output is
# rendered into. Left undeclared, twelve probes are skipped, each with a
# reason naming the option that would enable it.


# =============================================================================
#  2. WHICH MODELS WE USE
# =============================================================================
# Two SEPARATE profiles, and that is the point: a judge identical to its
# target shares its blind spots.

# Profile of the TARGET and of any call that names no profile: "local"
# (default, Ollama), "groq" or "api". Leave it "local": making a provider's
# raw model misbehave breaches their terms of use.
# ACTIVE_PROFILE=local

# The JUDGE's profile: "local" (default, Ollama), "groq" or "api".
# Measured: llama3.2 tops out at 50% recall, gpt-oss-120b reaches 100%.
# JUDGE_PROFILE=groq

# The "groq" profile.
#
# FREE tier caps: 8,000 tokens/minute AND 200,000/day. The daily one is what
# bites: a full consultation of the 209-entry corpus costs ~301,000 tokens,
# because a conversation carries its whole history into every call.
#
# The DEVELOPER plan keeps the same model and removes the daily cap (~250,000
# tokens/minute instead). Nothing in this repository changes: same profile,
# same GROQ_MODEL, same key. Staying on the same MODEL is the point — a change
# of model is a change of measurement, and `evaluate_judge` says so.
#
# FICTIONAL DATA ONLY on the free tier, and the reason is specific: several
# providers allow themselves to train on free-tier requests. On a paid plan
# that particular reason no longer applies — but whether the paid terms
# exclude training is a CONTRACTUAL question to read, not to assume, and the
# project's other rule stands either way: a client's data leaving their
# perimeter has to be in the engagement contract.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# The "api" profile (OpenAI or compatible)
OPENAI_API_KEY=
OPENAI_MODEL=


# =============================================================================
#  3. A CAMPAIGN'S BUDGET
# =============================================================================
# A circuit breaker, not an economy: a normal campaign consumes ~10 calls and
# ~12,000 tokens. These caps only stop what runs away — an adaptive agent with
# no guard, a cascade of retries, a replay inside a replay.
# Hitting the cap stops the campaign CLEANLY: it keeps its findings, and the
# report says at the top that it was cut short.
# 0 = no limit, to be used only in full knowledge of what that means.
# CALL_BUDGET=200
# TOKEN_BUDGET=500000
